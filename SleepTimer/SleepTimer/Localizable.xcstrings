    "Starts a Doze sleep timer. Your Mac sleeps when it ends, after a 60-second warning." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet einen Doze-Timer. Nach Ablauf und einer Warnung von 60 Sekunden schläft der Mac ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts a Doze sleep timer. Your Mac sleeps when it ends, after a 60-second warning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia un temporizador de Doze. Al terminar, tras un aviso de 60 segundos, el Mac entra en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre une minuterie Doze. À la fin, après un avertissement de 60 secondes, le Mac se met en veille."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí časovač Doze. Po jeho uplynutí a 60-sekundovom upozornení sa Mac uspí."
